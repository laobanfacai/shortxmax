# LumeReel — copy to .env and adjust.
# Brand (public, safe to expose)
NEXT_PUBLIC_SITE_NAME=ShortXMax
NEXT_PUBLIC_SITE_TAGLINE=Short dramas that hook you in minutes.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Database
# Local SQLite (Prisma resolves this path relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Later on a VPS with PostgreSQL, change prisma/schema.prisma provider to "postgresql"
# and set, for example:
# DATABASE_URL="postgresql://lumereel:PASSWORD@127.0.0.1:5432/lumereel?schema=public"

# Auth (generate a long random string for production)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Uploads (local now; later point to a mounted disk, then S3)
UPLOAD_DIR=./uploads
# Future S3 / object storage (leave empty to use local disk)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# Payments
# If DEMO_PAY_ENABLED=true (default), checkout works without real processor keys.
DEMO_PAY_ENABLED=true
# Stripe — test keys (pk_test_ / sk_test_). Optional live overrides below.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# PayPal — sandbox by default. Live: PAYPAL_MODE=live and live credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional ad pixels (leave empty until you have real IDs)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_TAG_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_LABEL=
# Storage: local disk is the default. R2 endpoints are configured in the admin UI.
# Default upload channel is R2 Studio (r2studio). Official Cloudflare R2 (r2) can be enabled in /admin/storage.
# New uploads never fall back to local disk.

# R2 Studio is the default upload channel. Configure the key in /admin/storage or here.
# The API key (starts with r2s_) must stay on the server — never put it in the client or commit it.
# R2_STUDIO_BASE_URL=https://r2.open-traffic.com
# R2_STUDIO_API_KEY=

# Server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
