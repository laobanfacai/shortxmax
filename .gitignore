# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# prisma local db
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# user-generated uploads (seed covers/videos in public/uploads are kept)
/uploads/**
!/uploads/.gitkeep
/public/uploads/tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts

# Private runtime backups and local QA output
/backups/
/test-results/
